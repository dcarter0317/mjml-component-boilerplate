<mjml>
  <mj-head>
    <mj-title>TaskCurrent Early Access Confirmation</mj-title>
    <mj-preview>TaskCurrent Early Access Confirmation</mj-preview>
    <mj-include path="./styles.mjml" />
    <mj-style>
      @media (max-width: 479px) {
        td.cta { text-align: center !important; }
        td.cta > table { margin: 0 auto !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#eef2f5">
    <!-- 2. Pull in your Reusable Header -->
    <mj-include path="./components/header/header.mjml" />

    <!-- 3. Main Email Body Content -->
    <!-- Pill element -->
    <mj-section padding="24px 24px 0" text-align="left">
      <mj-column width="100%">
        <mj-text padding="0" font-size="13px" line-height="16px" font-weight="600" color="#067647">
          <span style="display:inline-block;background-color:#b8f8e2;border-radius:50px;padding:6px 12px 6px 10px;"><img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791569130/icon-check2x.png" width="16" height="16" alt="" style="vertical-align:middle;border:0;margin-right:6px;" />Signup confirmed</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px 0">
      <mj-column width="100%">
        <mj-text mj-class="headline" padding="0">
          You’re on the early-access list.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-text mj-class="body-text" padding="0 0 16px">Hi Dave,</mj-text>
        <mj-text mj-class="body-text" padding="0 0 16px">Thanks for joining the TaskCurrent early-access list.</mj-text>
        <mj-text mj-class="body-text" padding="0 0 16px">We’re building TaskCurrent to help small teams spend less time on repetitive work like lead follow-up, scheduling, customer onboarding, and routine handoffs.</mj-text>
        <mj-text mj-class="body-text" padding="0">We’ll let you know when early access opens.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 24px">
      <mj-column width="100%" background-color="#E4E9F0" border-radius="8px" padding="20px">
        <mj-text padding="0 0 16px" text-transform="uppercase" font-weight="600" font-size="13px">what happens next</mj-text>
        <mj-table padding="0" cellpadding="0" cellspacing="0">
          <tr>
            <td width="24" valign="top" style="padding:0 12px 16px 0;"><img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791569130/icon-check2x.png" width="24" height="24" alt="" style="display:block;border:0;" /></td>
            <td valign="top" style="padding:0 0 16px 0;">
              <div style="font-size:15px;line-height:20px;color:#333333;">You joined the list</div>
              <div style="font-size:12px;line-height:20px;color:#667085;font-weight:300;">Today</div>
            </td>
          </tr>
          <tr>
            <td width="24" valign="top" style="padding:0 12px 16px 0;"><img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393538/icon_numbertwo2x.png" width="24" height="24" alt="" style="display:block;border:0;" /></td>
            <td valign="top" style="padding:0 0 16px 0;">
              <div style="font-size:15px;line-height:20px;color:#333333;">A few examples of what TaskCurrent can automate</div>
              <div style="font-size:12px;line-height:20px;color:#667085;font-weight:300;">In a couple of days</div>
            </td>
          </tr>
          <tr>
            <td width="24" valign="top" style="padding:0 12px 0 0;"><img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393538/icon_numberthree2x.png" width="24" height="24" alt="" style="display:block;border:0;" /></td>
            <td valign="top" style="padding:0;">
              <div style="font-size:15px;line-height:20px;color:#333333;">Your invite, as soon as early access opens</div>
              <div style="font-size:12px;line-height:20px;color:#667085;font-weight:300;">When access opens</div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- CTAs: columns stack on mobile -->
    <mj-section padding="24px 24px 8px" text-align="left">
      <mj-column width="208px" padding-bottom="8px">
        <mj-button mj-class="btn-primary" align="left" padding="0" css-class="cta" href="https://example.com">Explore TaskCurrent</mj-button>
      </mj-column>
      <mj-column width="160px">
        <mj-button mj-class="btn-icon" align="left" padding="0" css-class="cta" href="https://example.com">Book a Demo &#8594;</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px 24px">
      <mj-column width="100%">
        <mj-text mj-class="body-text" padding="0 0 4px">
          Talk soon,
        </mj-text>
        <mj-text mj-class="body-text" padding="0">
          The TaskCurrent team
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 4. Pull in your Reusable Footer -->
    <mj-include path="./components/footer/footer.mjml" />
  </mj-body>
</mjml>
