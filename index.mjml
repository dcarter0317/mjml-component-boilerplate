<!-- index.mjml -->
<mjml>
  <mj-head>
    <mj-include path="./styles.mjml" />
  </mj-head>

  <mj-body background-color="#eef2f5">
    <!-- 2. Pull in your Reusable Header -->
    <mj-include path="./components/header/header-dark.mjml" />

    <!-- 3. Main Email Body Content -->
    <mj-section padding="40px 20px">
      <mj-column width="100%">
        <mj-text font-size="24px" mj-class="header-elem" font-weight="bold" padding-bottom="15px">
          Hello World
        </mj-text>
        <mj-text font-size="16px" line-height="24px" padding-bottom="25px">
          This email template uses modular header and footer blocks. By editing the 'header.mjml' or 'footer.mjml' files directly, the changes will apply across all emails referencing them.
        </mj-text>

        <!-- Using a button component styled by the styleguide -->
        <mj-button mj-class="primary-btn" href="#">
          Get Started
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- 4. Pull in your Reusable Footer -->
    <mj-include path="./components/footer/footer-dark.mjml" />
  </mj-body>
</mjml>
